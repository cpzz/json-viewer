{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "用户信息",
  "description": "用户基本信息 Schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "姓名",
      "description": "用户的真实姓名",
      "minLength": 2,
      "maxLength": 50
    },
    "age": {
      "type": "integer",
      "title": "年龄",
      "description": "用户年龄",
      "minimum": 0,
      "maximum": 150
    },
    "email": {
      "type": "string",
      "title": "邮箱",
      "description": "用户邮箱地址",
      "format": "email"
    },
    "phone": {
      "type": "string",
      "title": "电话",
      "description": "用户联系电话",
      "pattern": "^1[3-9]\\d{9}$"
    },
    "gender": {
      "type": "string",
      "title": "性别",
      "enum": ["男", "女", "其他"],
      "default": "男"
    },
    "address": {
      "type": "object",
      "title": "地址",
      "description": "用户住址信息",
      "properties": {
        "province": {
          "type": "string",
          "title": "省份"
        },
        "city": {
          "type": "string",
          "title": "城市"
        },
        "street": {
          "type": "string",
          "title": "街道"
        }
      },
      "required": ["province", "city"]
    },
    "hobbies": {
      "type": "array",
      "title": "爱好",
      "description": "用户的兴趣爱好",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "isActive": {
      "type": "boolean",
      "title": "是否激活",
      "description": "账户是否处于激活状态",
      "default": true
    }
  },
  "required": ["name", "email"]
}
