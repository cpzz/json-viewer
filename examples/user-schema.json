{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "用户信息",
  "description": "用户基本信息 Schema 示例",
  "type": "object",
  "required": ["name", "email"],
  "properties": {
    "name": {
      "type": "string",
      "title": "姓名",
      "description": "用户姓名"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "邮箱",
      "description": "用户邮箱地址"
    },
    "age": {
      "type": "integer",
      "title": "年龄",
      "minimum": 0
    },
    "active": {
      "type": "boolean",
      "title": "是否激活",
      "default": true
    },
    "tags": {
      "type": "array",
      "title": "标签",
      "items": {
        "type": "string"
      }
    },
    "address": {
      "type": "object",
      "title": "地址",
      "properties": {
        "city": { "type": "string", "title": "城市" },
        "street": { "type": "string", "title": "街道" }
      }
    }
  }
}
